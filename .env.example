# Required. Get a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Public https URL of this server, so TinyFish Monitor can deliver scheduled
# results to POST /webhooks/tinyfish. Leave empty to use on-demand rechecks only.
# For local testing, a tunnel such as `cloudflared tunnel --url http://localhost:8787` works.
PUBLIC_BASE_URL=

# Random string that authenticates TinyFish webhooks (sent as ?token=).
WEBHOOK_SECRET=

# Optional bearer token that protects every API route except the webhook and /health.
TINYVERIFY_API_TOKEN=

PORT=8787
DATA_FILE=data/tinyverify-store.json

# Five-field cron, UTC unless prefixed with CRON_TZ=. Default: daily at 06:41 UTC.
DEFAULT_SCHEDULE_CRON="CRON_TZ=UTC 41 6 * * *"

# on: when Monitor's page cannot be parsed (bot wall), re-read with TinyFish Agent.
AGENT_ESCALATION=on
