{
  "name": "tinyverify",
  "version": "1.0.0",
  "description": "Verify licences and registrations from official registries using TinyFish Agent, Fetch, Search and Monitor, then watch them for status changes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "tinyverify": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "cli": "tsx src/cli.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "examples": "tsx scripts/examples.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@tiny-fish/sdk": "^0.11.0",
    "hono": "^4.6.14",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
